{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "declaration": true,
    "declarationDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@grid": ["src/index"],
      "@grid/*": ["src/*"],
      "@grid-react": ["grid-react/index"],
      "@grid-react/*": ["grid-react/*"]
    }
  },
  "include": ["test", "src", "grid-react", "vite.config.ts", "tsup.config.ts"]
}
