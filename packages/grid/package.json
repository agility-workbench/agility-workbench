{
  "name": "@agility-workbench/grid",
  "version": "0.3.0",
  "description": "A high-performance, framework-agnostic TypeScript data grid for building modern data workspaces.",
  "type": "module",
  "license": "MIT",
  "author": "Himanshu M",
  "homepage": "https://agilityworkbench.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agility-workbench/agility-workbench.git",
    "directory": "packages/grid"
  },
  "bugs": {
    "url": "https://github.com/agility-workbench/agility-workbench/issues"
  },
  "keywords": [
    "data-grid",
    "datagrid",
    "table",
    "data-table",
    "virtualized",
    "virtual-scroll",
    "spreadsheet",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node scripts/build-css.mjs",
    "build": "npm run clean && npm run generate && tsup",
    "typecheck": "npm run generate && tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "exceljs": "^4.4.0"
  }
}
