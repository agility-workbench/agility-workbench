{
  "name": "@agility-workbench/react-grid",
  "version": "0.1.0",
  "description": "React bindings for @agility-workbench/grid — a high-performance data grid.",
  "type": "module",
  "license": "MIT",
  "author": "Himanshu M",
  "homepage": "https://agilityworkbench.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agility-workbench/agility-workbench.git",
    "directory": "packages/react-grid"
  },
  "bugs": {
    "url": "https://github.com/agility-workbench/agility-workbench/issues"
  },
  "keywords": [
    "data-grid",
    "datagrid",
    "table",
    "react",
    "react-table",
    "virtualized",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@agility-workbench/grid": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3"
  }
}
