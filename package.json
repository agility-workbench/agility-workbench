{
  "name": "agility-workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Monorepo for the Agility Workbench data grid and its framework bindings.",
  "homepage": "https://agilityworkbench.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agility-workbench/agility-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/agility-workbench/agility-workbench/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "CHOKIDAR_USEPOLLING=1 vite",
    "preview": "vite preview",
    "generate": "npm run generate --workspace @agility-workbench/grid",
    "build": "npm run build --workspace @agility-workbench/grid && npm run build --workspace @agility-workbench/react-grid",
    "typecheck": "npm run generate && tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "npm run clean --workspaces --if-present && rm -rf dist dist-demo"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "exceljs": "^4.4.0",
    "happy-dom": "^20.10.6",
    "postcss": "^8.4.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
